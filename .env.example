# Шаблон .env: все переменные проекта, значения пустые. Формат строго NAME=value, без пробелов вокруг = и без кавычек.
# Пустое значение = значение по умолчанию (указано в комментарии). Запуск: cp .env.example .env && docker compose up --build
# Для жюри заполненный .env лежит в репозитории только в зашифрованном виде: secrets.env.age (README, «Секреты для жюри»).
# Без ключа LLM всё основное работает: поиск разбирает запрос по ключевым словам из реестра, ответы отельера правилами,
# новые характеристики по шаблонам. С ключом включаются живой разбор запросов, чат-агент и компилятор характеристик.

# --- LLM, вариант 1 (основной): Claude через официальный SDK Anthropic ---
# Ключ провайдера LLM (для жюри отдельный ключ). Где взять: https://console.anthropic.com → Settings → API Keys (sk-ant-...)
ANTHROPIC_API_KEY=
# Вместо ключа: bearer-токен, если запросы идут через шлюз или прокси. По умолчанию не используется.
ANTHROPIC_AUTH_TOKEN=
# Свой адрес API (корпоративный шлюз). По умолчанию https://api.anthropic.com
ANTHROPIC_BASE_URL=
# Провайдер: anthropic | openai | none. По умолчанию выбирается по заданному ключу; нужен, если ключей несколько.
LLM_PROVIDER=
# Модель. По умолчанию claude-opus-5-5 (Anthropic) или gpt-4.1 (OpenAI-совместимый)
LLM_MODEL=

# --- LLM, вариант 2: любой OpenAI-совместимый API (OpenAI, OpenRouter, DeepSeek, vLLM, Ollama, LM Studio) ---
# Ключ или адрес сами включают этот вариант. Модель должна уметь вызывать инструменты (tools).
# Где взять ключ: https://platform.openai.com/api-keys или у выбранного провайдера; локальному серверу ключ не нужен.
OPENAI_API_KEY=
# Адрес API. По умолчанию https://api.openai.com/v1; локальная модель на хосте из Docker: http://host.docker.internal:11434/v1
OPENAI_BASE_URL=

# --- Вариант 0, только без Docker: установлен Claude Code и выполнен вход, ключ не нужен (LLM_PROVIDER=claude-cli) ---

# --- Наш агент как OpenAI-совместимый API: http://localhost:8080/v1 (модель ostrovok-agent) ---
# Ключ, который клиенты передают как обычный OpenAI API key. По умолчанию пусто = доступ открыт.
AGENT_API_KEY=

# --- Роли (демо-вход для жюри; в продакшене токен выдаёт партнёрский вход Островка) ---
# Пароль админа. По умолчанию demo
ADMIN_PASSWORD=
# Код отельера. По умолчанию demo
HOTELIER_DEMO_CODE=
# Секрет подписи токенов. По умолчанию создаётся один раз в data/cache/auth_secret
AUTH_SECRET=
# Токен для изменяющих MCP-инструментов (add_characteristic, answer_question). По умолчанию пусто = MCP только читает
MCP_ADMIN_TOKEN=

# --- Порты на хосте (в контейнере приложение всегда на 8080, MCP на 8001) ---
# По умолчанию 8080
APP_PORT=
# По умолчанию 8001
MCP_PORT=

# --- Регион и кластеры вкуса ---
# Регион: adler, hosta или собранный во вкладке «Регионы». По умолчанию центр Сочи
REGION=
# Режим кластеров вкуса: auto | shadow | on | off. По умолчанию auto
TASTE_MODE=
# 1 = демо кластеров на синтетических посетителях. По умолчанию выключено
TASTE_DEMO=
# Ключ для POST /api/taste/refit и /api/taste/seed без TASTE_DEMO. По умолчанию пусто
TASTE_ADMIN_KEY=
